# Enter these in Netlify project Environment Variables (not netlify.toml).
# Shared staff PIN for starter/demo. Choose 8+ unpredictable characters.
POS_ACCESS_PIN=REPLACE_WITH_A_STRONG_PRIVATE_PIN
# 32+ randomly generated characters.
COOKIE_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
# Discord channel > Edit Channel > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=
# Example 0.0825 = 8.25%. Verify your actual rate.
TAX_RATE=0
